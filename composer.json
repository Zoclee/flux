{
    "name": "zoclee/flux",
    "description": "Flux is a pure PHP implementation of a unified message broker with PostgreSQL persistence.",
    "type": "project",
    "license": "MIT",
    "bin": [
        "flux"
    ],
    "require": {
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Flux\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flux\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
